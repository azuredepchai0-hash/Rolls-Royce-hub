---------------------------------------------------------------------

MoveTab:CreateSection("Visuals")

MoveTab:CreateSlider({
   Name = "Field of View (FOV)",
   Range = {70, 120},
   Increment = 1,
   CurrentValue = 90,
   Callback = function(Value) Settings.FOV = Value end,
})

MoveTab:CreateSection("Automation & Physics")

MoveTab:CreateToggle({
   Name = "Auto Bhop",
   CurrentValue = false,
   Callback = function(Value) Settings.BhopEnabled = Value end,
})

MoveTab:CreateButton({
   Name = "⚡ Activate Edge Trimp Script",
   Callback = function()
      local Players = game:GetService("Players")
      local RunService = game:GetService("RunService")
      local StarterGui = game:GetService("StarterGui")
      local UserInputService = game:GetService("UserInputService")

      local BOOST_POWER = 100
      local MIN_Y_VELOCITY_TO_ACTIVATE = 1.0
      local isEnabled = true
      local player = Players.LocalPlayer

      local function getCharacterAndHrp()
          local character = player.Character or player.CharacterAdded:Wait()
          return character, character:WaitForChild("HumanoidRootPart"), character:WaitForChild("Humanoid")
      end

      local character, hrp, humanoid = getCharacterAndHrp()
      local UP_VELOCITY = Vector3.new(0, BOOST_POWER, 0)

      local function applyEdgeBoost()
          if not isEnabled or not hrp or not humanoid or humanoid.Health <= 0 then return end
          if hrp.AssemblyLinearVelocity.Y < -MIN_Y_VELOCITY_TO_ACTIVATE then
              local touchingParts = hrp:GetTouchingParts()
              if #touchingParts > 0 then
                  local currentHorizontalVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
                  hrp.AssemblyLinearVelocity = currentHorizontalVelocity + UP_VELOCITY
              end
          end
      end

      RunService.Stepped:Connect(applyEdgeBoost)
      
      UserInputService.InputBegan:Connect(function(input, gp)
          if not gp and input.KeyCode == Enum.KeyCode.U then
              isEnabled = not isEnabled
              StarterGui:SetCore("SendNotification", {
                  Title = "Edge Trimp", 
                  Text = isEnabled and "Enabled ✅" or "Disabled ❌", 
                  Duration = 2
              })
          end
      end)

      StarterGui:SetCore("SendNotification", {Title = "Edge Trimp", Text = "Active! Press U to Toggle.", Duration = 5})
   end,
})

