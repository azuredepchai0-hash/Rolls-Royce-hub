-- CORE LOGIC
---------------------------------------------------------------------

local RunService = game:GetService("RunService")
local player = game.Players.LocalPlayer

RunService.PreRender:Connect(function()
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if hum and hrp then
        game.Workspace.CurrentCamera.FieldOfView = Settings.FOV
        if Settings.BhopEnabled and hum.MoveDirection.Magnitude > 0 then
            if hum.FloorMaterial ~= Enum.Material.Air then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
        if Settings.BounceEnabled and hrp.AssemblyLinearVelocity.Y < -5 then
            local parts = hrp:GetTouchingParts()
            if #parts > 0 then
                hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, Settings.BounceAmount, hrp.AssemblyLinearVelocity.Z)
            end
        end
    end
end)

