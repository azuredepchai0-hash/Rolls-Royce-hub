-- TAB: MODEL MAP (WITH REMOVE INVIS WALL)
---------------------------------------------------------------------

MapTab:CreateSection("AzureX Special Utilities")

MapTab:CreateButton({
   Name = "🛡️ Remove Invis Wall",
   Callback = function()
      local Workspace = game:GetService("Workspace")
      local count = 0
      for _, obj in pairs(Workspace:GetDescendants()) do
          if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and obj.Transparency >= 0.8 and obj.Position.Y > 50 then
              pcall(function() obj:Destroy() end)
              count = count + 1
          end
      end
      Rayfield:Notify({Title = "AzureX", Content = "Successfully removed " .. count .. " invis walls!", Duration = 3})
   end,
})

MapTab:CreateSection("Model Spawner & Customization")

MapTab:CreateInput({
   Name = "Asset ID",
   PlaceholderText = "Enter Model ID...",
   Callback = function(Text) Settings.ModelId = Text end,
})

MapTab:CreateSlider({
   Name = "Spawn Height (Y)",
   Range = {0, 500},
   Increment = 5,
   CurrentValue = 50,
   Callback = function(Value) Settings.SpawnHeight = Value end,
})

MapTab:CreateSlider({
   Name = "Model Scale (Size)",
   Range = {1, 20},
   Increment = 1,
   CurrentValue = 1,
   Callback = function(Value) Settings.ModelScale = Value end,
})

MapTab:CreateToggle({
   Name = "Auto Anchor",
   CurrentValue = true,
   Callback = function(Value) Settings.AutoAnchor = Value end,
})

MapTab:CreateButton({
   Name = "🚀 Spawn Model",
   Callback = function()
      if Settings.ModelId ~= "" and tonumber(Settings.ModelId) then
         local success, objects = pcall(function() return game:GetObjects("rbxassetid://" .. Settings.ModelId) end)
         if success and objects then
            local container = Instance.new("Model", workspace)
            container.Name = "RR_Spawned_" .. Settings.ModelId
            table.insert(SpawnedModels, container)
            
            for _, obj in pairs(objects) do
               obj.Parent = container
               if Settings.ModelScale > 1 then
                   if obj:IsA("Model") then obj:ScaleTo(obj:GetScale() * Settings.ModelScale)
                   elseif obj:IsA("BasePart") then obj.Size = obj.Size * Settings.ModelScale end
               end
               if Settings.AutoAnchor then
                  for _, child in pairs(obj:GetDescendants()) do
                     if child:IsA("BasePart") then child.Anchored = true end
                  end
               end
            end
            
            local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
            container:MoveTo(hrp.Position + Vector3.new(0, Settings.SpawnHeight, 0))
            Rayfield:Notify({Title = "Success", Content = "Model Spawned!", Duration = 2})
         end
      end
   end,
})

MapTab:CreateButton({
   Name = "🗑️ Delete All Spawned Models",
   Callback = function()
      for _, model in pairs(SpawnedModels) do if model then model:Destroy() end end
      SpawnedModels = {}
      Rayfield:Notify({Title = "System", Content = "Cleaned up all spawned models.", Duration = 3})
   end,
})

